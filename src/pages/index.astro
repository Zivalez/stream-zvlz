---
import 'github-markdown-css/github-markdown.css';
import { marked } from 'marked';

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

const mdUrl = import.meta.env.MD_URL || 'https://assets-cdn.zvlz.my.id/cloudstream.md';
let markdownContent = '';

try {
  const response = await fetch(mdUrl, {
    headers: {
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
      'Accept': 'text/plain, text/markdown, */*',
      'Cache-Control': 'no-cache'
    },
    cache: 'no-store'
  });
  if (!response.ok) {
    throw new Error(`Failed to fetch markdown: ${response.status} ${response.statusText}`);
  }
  markdownContent = await response.text();
} catch (error) {
  console.error(error);
  markdownContent = '> Failed to load content. Please check the URL or try again later.';
}

const htmlContent = await marked.parse(markdownContent);
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
		<title>stream-zvlz</title>
		<style>
			:root {
				--font-inter: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
				--font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, Liberation Mono, monospace;
			}
			.markdown-wrapper {
				box-sizing: border-box;
				min-width: 200px;
				max-width: 980px;
				margin: 0 auto;
				padding: 45px;
			}
			/* Set a background color that looks good behind the dark/light markdown body */
			body {
				margin: 0;
			}
			.markdown-body {
				font-family: var(--font-inter) !important;
			}
			.markdown-body code,
			.markdown-body pre,
			.markdown-body tt {
				font-family: var(--font-mono) !important;
			}
			@media (prefers-color-scheme: dark) {
				body {
					background-color: #0d1117;
				}
			}
			@media (max-width: 767px) {
				.markdown-wrapper {
					padding: 15px;
				}
				.markdown-body {
					font-size: 14px !important;
				}
			}
			.code-wrapper {
				position: relative;
				margin-bottom: 16px;
			}
			.code-wrapper pre {
				margin-bottom: 0 !important;
			}
			.copy-button {
				position: absolute;
				top: 0;
				right: 0;
				padding: 5px 8px;
				font-size: 12px;
				color: var(--color-fg-muted, #8b949e);
				background-color: var(--color-canvas-subtle, #161b22);
				border: 1px solid var(--color-border-default, #30363d);
				border-radius: 0;
				cursor: pointer;
				opacity: 0;
				transition: opacity 0.2s, background-color 0.2s;
				z-index: 10;
			}
			.code-wrapper:hover .copy-button {
				opacity: 1;
			}
			.copy-button:hover {
				background-color: var(--color-btn-hover-bg, #30363d);
			}
			.copy-button.copied {
				color: #3fb950;
				border-color: #3fb950;
			}
			.screenshot-gallery {
				display: grid !important;
				grid-template-columns: repeat(2, 1fr) !important;
				gap: 16px !important;
				margin: 24px auto !important;
				max-width: 600px !important;
			}
			.screenshot-gallery img {
				width: 100% !important;
				height: auto !important;
				aspect-ratio: 9 / 21 !important;
				object-fit: cover !important;
				border-radius: 12px !important;
				border: 1px solid var(--color-border-default, #30363d) !important;
				display: block !important;
			}
			@media (max-width: 768px) {
				.screenshot-gallery {
					grid-template-columns: 1fr !important;
					max-width: 100% !important;
				}
			}
			/* Download Button */
			.download-btn {
				display: inline-block;
				padding: 12px 24px;
				font-size: 16px;
				font-weight: 600;
				font-family: var(--font-inter) !important;
				color: #ffffff;
				background-color: #238636;
				border: 1px solid rgba(240, 246, 252, 0.1);
				border-radius: 6px;
				text-decoration: none !important;
				cursor: pointer;
				transition: background-color 0.2s;
			}
			.download-btn:hover {
				background-color: #2ea043;
				text-decoration: none !important;
			}
			.download-btn:active {
				background-color: #1a7f37;
			}
			.shields-badge {
				height: 32px !important;
				margin: 12px 0 !important;
				border: none !important;
			}
		</style>
	</head>
	<body>
		<main class="markdown-wrapper">
			<article class="markdown-body" set:html={htmlContent} />
		</main>

		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const headings = document.querySelectorAll('.markdown-body h1, .markdown-body h2, .markdown-body h3');
				headings.forEach((heading) => {
					if (heading.textContent.trim().includes("Fitur Utama CloudStream")) {
					const level = parseInt(heading.tagName[1]);
					let lastEl = heading;
					let sibling = heading.nextElementSibling;
					while (sibling) {
						const tag = sibling.tagName;
						if (/^H[1-6]$/.test(tag) && parseInt(tag[1]) <= level) break;
						lastEl = sibling;
						sibling = sibling.nextElementSibling;
					}
					
					const gallery = document.createElement('div');
					gallery.className = 'screenshot-gallery';
					gallery.style.cssText = `
						display: grid !important;
						grid-template-columns: repeat(2, 1fr) !important;
						gap: 16px !important;
						max-width: 600px !important;
						margin: 24px auto !important;
					`;
					gallery.innerHTML = `
					<img src="https://public-assets.zvlz.my.id/cloudstream/ss1.avif" 
						alt="Screenshot 1" loading="lazy" 
						style="width:100%; height:auto; aspect-ratio:9/21; object-fit:cover; border-radius:12px; border:1px solid #30363d;">
					<img src="https://public-assets.zvlz.my.id/cloudstream/ss2.avif" 
						alt="Screenshot 2" loading="lazy" 
						style="width:100%; height:auto; aspect-ratio:9/21; object-fit:cover; border-radius:12px; border:1px solid #30363d;">
					`;
					lastEl.after(gallery);
					}
				});
				const preBlocks = document.querySelectorAll('.markdown-body pre');

				// Convert download links to buttons
				const allLinks = document.querySelectorAll('.markdown-body a');
				allLinks.forEach((link) => {
				if (link.href && link.href.toLowerCase().endsWith('.apk')) {
					const fileSize = "62MB"; // Ganti sesuai ukuran APK kamu
					link.outerHTML = `
					<a href="${link.href}" target="_blank" rel="noopener noreferrer" class="cursor-pointer">
					<img src="https://img.shields.io/badge/Download-CloudStream_${fileSize}-blue?style=for-the-badge&logo=android" 
						alt="Download CloudStream APK (${fileSize})" class="shields-badge">
					</a>
					`;
				}
				});

				preBlocks.forEach((pre) => {
					const wrapper = document.createElement('div');
					wrapper.className = 'code-wrapper';
					pre.parentNode.insertBefore(wrapper, pre);
					wrapper.appendChild(pre);
					const button = document.createElement('button');
					button.className = 'copy-button';
					button.textContent = 'Copy';
					const code = pre.querySelector('code');
					button.addEventListener('click', async () => {
						try {
							const textToCopy = code ? code.innerText : pre.innerText;
							await navigator.clipboard.writeText(textToCopy);
							const originalText = button.textContent;
							button.textContent = 'Copied!';
							button.classList.add('copied');
							setTimeout(() => {
								button.textContent = originalText;
								button.classList.remove('copied');
							}, 2000);
						} catch (err) {
							console.error('Failed to copy text: ', err);
						}
					});
					
					wrapper.appendChild(button);
				});
			});
		</script>
	</body>
</html>
